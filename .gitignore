# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets (API keys)
.env

# Source PDFs: we link to official sources, not re-host them (manifest.jsonl stays tracked)
docs/**/*.pdf
.DS_Store

# Everything made from the documents (data/ingested, data/cache, data/runs), and data/private/:
# the private petitions, their gold, page images and runs. Never committed.
data/
# Page images for checking by eye (made by eval_results/draw_heldout.py, archive/experiments/review_flagged.py).
# Re-creatable, large, and some are pages of the ICAI Rules book, which we don't re-host.
eval_results/pages/
archive/experiments/flagged_review/*.png
